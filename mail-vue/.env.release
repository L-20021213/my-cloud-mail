NODE_ENV = 'release'
VITE_APP_TITLE = '发布环境'
# Cloudflare Worker API 地址，Vercel 部署时请在项目环境变量中覆盖。
# 示例：https://cloud-mail.example.workers.dev/api
VITE_BASE_URL = 'https://YOUR-WORKER.workers.dev/api'
# 用于附件、登录背景等由 Worker 提供的站内资源。
# 示例：https://cloud-mail.example.workers.dev
VITE_ASSET_BASE_URL = 'https://YOUR-WORKER.workers.dev'
VITE_PWA_NAME = 'Cloud Mail'
VITE_OUT_DIR = dist
